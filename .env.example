# Google Analytics 4 measurement ID (public).
# The site reads this value. If it is blank or invalid, tracking falls back to G-EJ58C7NBCJ
# so analytics works without any Vercel setting. Set a different G- ID here only to override it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-EJ58C7NBCJ

# Firebase web app config used by the existing client SDK (blog, analytics, and website leads).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Trial and demo notification email (Gmail SMTP).
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# Admin login session.
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Blog content generation in the admin.
GEMINI_API_KEY=

# Firebase Admin SDK, server only. Required for the admin Leads page (/admin/leads).
# The browser must not read websiteLeads. Do not change the create-only Firestore rules.
# Use either the full service account JSON on one line, or the three fields below.
# In FIREBASE_PRIVATE_KEY, keep the BEGIN/END lines and write newlines as \n.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
